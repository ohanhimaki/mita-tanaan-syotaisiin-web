@using MTS.Application
@using MTS.Application.DataFetching
@using System.Text.Json
@inject IJSRuntime JSRuntime
<MudContainer Style="background-color: #f5f5f5; min-height: 100vh; padding-top: 20px; padding-bottom: 20px;">

  <MudCard Style="margin-bottom: 24px;">
    @* buttons for every weekday *@

    <MudCardContent>
      @for (var i = 1; i <= 5; i++)
      {
        var day = i;
        <MudButton Variant="Variant.Filled" Color="SelectedDay == day ? Color.Primary : Color.Default" OnClick="() => SelectedDay = day">@GetDayOfWeekFi(day)</MudButton>
      }
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DownloadImages">Download images</MudButton>
    </MudCardContent>
  </MudCard>

  @if (Lists is not null)
  {
    var emojiCount = 1;
    <div class="masonry-grid">
    @foreach (var lunchListContainer in Lists.Where(x => x.DayNumber == SelectedDay ||x.DayNumber == 999).OrderByDescending(x => x.BestFoodTitles.Count).ThenBy(x => x.RestaurantManagement.nimi))
    {
      var emoji = lunchListContainer.RestaurantManagement.emoji ?? GetEmoji(emojiCount++);
      <div class="masonry-item" id="@lunchListContainer.RestaurantManagement.nimi">
        @foreach( var titles in lunchListContainer.BestFoodTitles)
        {
          <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Elevation="0" Style="margin-bottom: 16px;">
            <MudText Typo="Typo.h6">⭐ @titles</MudText>
          </MudAlert>
        }

        <MudCard Class="to-image">
          <MudCardContent>
            <MudText @onclick="() => DownloadImage(lunchListContainer.RestaurantManagement.nimi)" Class="file-name" Typo="Typo.h4" Color="Color.Primary">@emoji @lunchListContainer.RestaurantManagement.nimi</MudText>
            <br/>
            @((MarkupString)lunchListContainer.DescriptionHtml)
          </MudCardContent>
        </MudCard>
      </div>
    }
    </div>
  }
</MudContainer>

@code {

  [Inject]
  HttpClient Http { get; set; }
  public int SelectedDay { get; set; } = 1;

  private string CacheKey
  {
    get
    {
      var week = System.Globalization.ISOWeek.GetWeekOfYear(DateTime.Now);
      return $"lunchlists_v1_{DateTime.Now.Year}_{week}";
    }
  }

  protected override async Task OnInitializedAsync()
  {
    SelectedDay = (int)DateTime.Now.DayOfWeek;
    if (SelectedDay == 0) SelectedDay = 5;

    Lists = await TryLoadFromCache();

    // Refresh from API in background - don't await so cached data renders first
    _ = RefreshListsFromApi();

    await base.OnInitializedAsync();
  }

  private async Task<List<LunchListContainer>?> TryLoadFromCache()
  {
    try
    {
      var json = await JSRuntime.InvokeAsync<string?>("localStorageHelper.getItem", CacheKey);
      if (string.IsNullOrEmpty(json)) return null;
      return JsonSerializer.Deserialize<List<LunchListContainer>>(json);
    }
    catch (Exception e)
    {
      Console.WriteLine($"Cache load error: {e.Message}");
      return null;
    }
  }

  private async Task SaveToCache(List<LunchListContainer> lists)
  {
    try
    {
      var json = JsonSerializer.Serialize(lists);
      await JSRuntime.InvokeVoidAsync("localStorageHelper.setItem", CacheKey, json);
    }
    catch (Exception e)
    {
      Console.WriteLine($"Cache save error: {e.Message}");
    }
  }

  private async Task RefreshListsFromApi()
  {
    Restaurants = await GetRestaurantsFromJson();
    var bestFoods = await Http.GetFromJsonAsync<List<BestFood>>("/best-foods.json");
    var bestFoodsDict = bestFoods!.ToDictionary(g => g.Name, g => g.SearchTerms.ToList());
    try
    {
      var lists = await LunchListFetcher.GetLunchListAsync(Restaurants);
      foreach (var list in lists)
      {
        try { list.HighlightBestFoods(bestFoodsDict); }
        catch (Exception ex) { Console.WriteLine($"HighlightBestFoods error for {list.RestaurantManagement?.nimi}: {ex.Message}"); }
      }

      Lists = lists;
      await SaveToCache(lists);
      await InvokeAsync(StateHasChanged);
    }
    catch (Exception e)
    {
      Console.WriteLine(e);
    }
  }

  public List<RestaurantManagement> Restaurants { get; set; }

  private async Task<List<RestaurantManagement>> GetRestaurantsFromJson()
  {
  // return list from restaurants.json wwwroot with httpclient get request


    var list = await Http.GetFromJsonAsync<List<RestaurantManagement>>("/restaurants.json");
    return list;
  }

  public List<LunchListContainer>? Lists { get; set; }

  private async Task DownloadImages()
  {
    await JSRuntime.InvokeVoidAsync("captureAndDownloadImages");
  }


  private string GetEmoji(int i)
  {
    // list of 10 face emojis
    var emojis = new List<string> { "😀", "😃", "😄", "😁", "😆", "😅", "😂", "🤣", "😊", "😇" };
    return emojis[i % 10];
  }

  private string GetDayOfWeekFi(int day)
  {
    return day switch
    {
      1 => "Ma",
      2 => "Ti",
      3 => "Ke",
      4 => "To",
      5 => "Pe",
      _ => "??"
    };
  }

  private async Task DownloadImage(string restaurantManagementNimi)
  {
    Console.WriteLine(restaurantManagementNimi);
    await JSRuntime.InvokeVoidAsync("captureAndDownloadImage", restaurantManagementNimi);
  }

}
