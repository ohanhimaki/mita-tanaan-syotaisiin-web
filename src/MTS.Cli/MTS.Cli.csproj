<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MTS.Cli</RootNamespace>
    <AssemblyName>mts</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linkitetään suoraan wwwroot:sta jotta ei tule duplikaattia -->
    <EmbeddedResource Include="..\MTS.Web\wwwroot\restaurants.json" LogicalName="restaurants.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTS.Application\MTS.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RazorConsole.Core" Version="0.4.0" />
  </ItemGroup>

</Project>
